generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  password      String
  phone         String?
  image         String?       @db.Text
  role          UserRole      @default(PATIENT)
  isActive      Boolean       @default(true)
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  blogs         Blog[]
  doctor        Doctor?
  facility      Facility?
  claims        DoctorClaim[]
  facilityClaims FacilityClaim[]
  reviews       Review[]
  otpCodes      OtpCode[]
  appointments  Appointment[]
  bookedAppointments Appointment[] @relation("BookedByUser")
  schedules     Schedule[]    @relation("ScheduleCreatedBy")
  dateOverrides DateOverride[] @relation("OverrideCreatedBy")
  receptionist  Receptionist?
  smsBalance    SmsBalance?
  smsTransactions SmsTransaction[]
  pendingBkashPayments PendingBkashPayment[]
}

model Doctor {
  id               Int              @id @default(autoincrement())
  userId           Int?             @unique
  fullName         String
  slug             String           @unique
  profilePhoto     String?          @db.Text
  degrees          String?          @db.Text
  designation      String?
  gender           Gender?
  bmdcNumber       String?          @unique
  experienceYears  Int?
  consultationFee  Int?
  followUpFee      Int?
  visitingHours    String?          @db.Text
  services         String?          @db.Text
  about            String?          @db.LongText
  phone            String?
  appointmentPhone String?
  email            String?
  website          String?
  facebook         String?
  linkedin         String?
  hospitalName     String?
  chamberAddress   String?          @db.Text
  city             String?
  area             String?
  isVerified       Boolean          @default(false)
  profileClaimed   Boolean          @default(false)
  createdByAdmin   Boolean          @default(true)
  status           DoctorStatus     @default(PUBLISHED)
  specialtyId      Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  avgConsultationMinutes Int        @default(10)
  smsEnabled       Boolean          @default(false)
  blogs            Blog[]
  specialty        Specialty?       @relation(fields: [specialtyId], references: [id])
  user             User?            @relation(fields: [userId], references: [id])
  claims           DoctorClaim[]
  doctorFacilities DoctorFacility[]
  reviews          Review[]
  schedules        Schedule[]
  slots            ScheduleSlot[]
  appointments     Appointment[]
  receptionists    Receptionist[]
  dateOverrides    DateOverride[]

  @@index([fullName])
  @@index([city])
  @@index([area])
  @@index([specialtyId])
}

model OtpCode {
  id          Int      @id @default(autoincrement())
  userId      Int
  identifier  String   // email or phone used
  otpHash     String   // hashed OTP for security
  method      OtpMethod
  purpose     OtpPurpose @default(PASSWORD_RESET)
  expiresAt   DateTime
  consumed    Boolean  @default(false)
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose, consumed])
  @@index([userId, purpose])
  @@index([expiresAt])
}

enum OtpMethod {
  EMAIL
  WHATSAPP
  SMS
}

enum OtpPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  TWO_FACTOR_AUTH
}

model Specialty {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctors   Doctor[]
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  doctorId   Int
  userId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([userId])
}

model DoctorClaim {
  id           Int         @id @default(autoincrement())
  doctorId     Int
  userId       Int
  bmdcNumber   String?
  licenseImage String?     @db.Text
  note         String?     @db.Text
  status       ClaimStatus @default(PENDING)
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  doctor       Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([userId])
}

model Blog {
  id            Int        @id @default(autoincrement())
  title         String
  slug          String     @unique
  excerpt       String?    @db.Text
  content       String     @db.LongText
  featuredImage String?    @db.Text
  status        BlogStatus @default(DRAFT)
  authorId      Int
  doctorId      Int?
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  author        User       @relation(fields: [authorId], references: [id])
  doctor        Doctor?    @relation(fields: [doctorId], references: [id])

  @@index([slug])
  @@index([authorId], map: "Blog_authorId_fkey")
  @@index([doctorId], map: "Blog_doctorId_fkey")
}

model Division {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  districts District[]
}

model District {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String    @unique
  divisionId Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  division   Division  @relation(fields: [divisionId], references: [id])
  upazilas   Upazila[]

  @@index([divisionId])
}

model Upazila {
  id         Int        @id @default(autoincrement())
  name       String
  slug       String     @unique
  districtId Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  facilities Facility[]
  district   District   @relation(fields: [districtId], references: [id])

  @@index([districtId])
}

model Facility {
  id               Int              @id @default(autoincrement())
  userId           Int?             @unique
  name             String
  slug             String           @unique
  type             FacilityType     @default(HOSPITAL)
  logo             String?          @db.Text
  address          String?          @db.Text
  phone            String?
  hotline          String?
  email            String?
  website          String?
  emergencyContact String?
  profileClaimed   Boolean          @default(false)
  isVerified       Boolean          @default(false)
  upazilaId        Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User?            @relation(fields: [userId], references: [id])
  doctorFacilities DoctorFacility[]
  tests            FacilityTest[]
  upazila          Upazila          @relation(fields: [upazilaId], references: [id])
  claims           FacilityClaim[]
  schedules        Schedule[]
  facilitySlots    ScheduleSlot[]

  @@index([slug])
  @@index([upazilaId])
}

model FacilityTest {
  id                  Int          @id @default(autoincrement())
  facilityId          Int
  code                String
  name                String
  category            String
  price               Int
  discountPrice       Int?
  sampleType          String?
  deliveryTime        String?
  preparation         String?      @db.Text
  homeSampleAvailable Boolean      @default(false)
  description         String?      @db.Text
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  facility            Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([category])
  @@index([name])
}

model FacilityClaim {
  id                  Int         @id @default(autoincrement())
  facilityId          Int
  userId              Int
  officialPhone       String?
  officialEmail       String?
  designation         String?
  tradeLicenseNumber  String?
  tradeLicenseImage   String?     @db.Text
  authorizationLetter String?     @db.Text
  note                String?     @db.Text
  status              ClaimStatus @default(PENDING)
  reviewedAt          DateTime?
  createdAt           DateTime    @default(now())
  facility            Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([userId])
}

model DoctorFacility {
  id         Int      @id @default(autoincrement())
  doctorId   Int
  facilityId Int
  createdAt  DateTime @default(now())
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([doctorId, facilityId])
  @@index([doctorId])
  @@index([facilityId])
}

enum UserRole {
  ADMIN
  DOCTOR
  PATIENT
  FACILITY_ADMIN
}

enum DoctorStatus {
  DRAFT
  PUBLISHED
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FacilityType {
  HOSPITAL
  DIAGNOSTIC
  CLINIC
  PHARMACY
  CHAMBER
}

// =====================================================================
// APPOINTMENT & SCHEDULE MANAGEMENT (Serial Booking System)
// =====================================================================

model Receptionist {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  userId       Int      @unique
  name         String
  phone        String
  canCancel    Boolean  @default(true)
  canBookOffline Boolean @default(true)
  canMarkNoShow Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookedAppointments Appointment[] @relation("BookedByReceptionist")

  @@index([doctorId])
  @@index([userId])
}

model Schedule {
  id             Int      @id @default(autoincrement())
  doctorId       Int
  facilityId     Int?
  dayOfWeek      Int      // 0=Sunday, 1=Monday ... 6=Saturday
  startTime      String   // "17:00" (24h)
  endTime        String   // "21:00" (24h)
  slotDuration   Int      @default(10) // minutes
  maxPatients    Int      @default(20)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean  @default(true)
  createdById    Int
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctor     Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  createdBy  User   @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  slots      ScheduleSlot[]
  dateOverrides DateOverride[]

  @@index([doctorId, isActive])
  @@index([dayOfWeek, isActive])
}

model DateOverride {
  id             Int      @id @default(autoincrement())
  scheduleId     Int
  doctorId       Int
  overrideDate   DateTime @db.Date
  isBlocked      Boolean  @default(true) // true = chamber off, false = extra day
  reason         String?  @db.Text
  createdById    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("OverrideCreatedBy", fields: [createdById], references: [id])

  @@unique([scheduleId, overrideDate])
  @@index([doctorId, overrideDate])
  @@index([scheduleId, overrideDate])
}

model ScheduleSlot {
  id             Int      @id @default(autoincrement())
  scheduleId     Int
  doctorId       Int
  facilityId     Int?
  slotDate       DateTime @db.Date
  startTime      DateTime
  endTime        DateTime
  serialNumber   Int
  status         SlotStatus @default(AVAILABLE)
  blockedReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility    Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  appointment Appointment?

  @@unique([scheduleId, slotDate, serialNumber])
  @@index([doctorId, slotDate])
  @@index([slotDate, status])
  @@index([scheduleId, slotDate])
}

model Appointment {
  id                  Int      @id @default(autoincrement())
  slotId              Int      @unique
  doctorId            Int
  patientId           Int
  patientName         String
  patientPhone        String
  patientEmail        String?
  serialNumber        Int
  bookingSource       BookingSource
  bookedByUserId      Int?     // patient self-booked
  bookedByReceptionistId Int?  // receptionist offline-booked
  status              AppointmentStatus @default(SCHEDULED)
  chiefComplaint      String?  @db.Text
  estimatedTime       DateTime?
  actualStartTime     DateTime?
  actualEndTime       DateTime?
  cancelledAt         DateTime?
  cancelledByUserId   Int?
  cancellationReason  String?
  smsConfirmationSent Boolean  @default(false)
  smsReminderSent     Boolean  @default(false)
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  slot                ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  doctor              Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient             User         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bookedByUser        User?        @relation("BookedByUser", fields: [bookedByUserId], references: [id], onDelete: SetNull)
  bookedByReceptionist Receptionist? @relation("BookedByReceptionist", fields: [bookedByReceptionistId], references: [id], onDelete: SetNull)

  @@index([doctorId, status])
  @@index([patientId])
  @@index([status])
  @@index([slotId])
}

// =====================================================================
// SMS BALANCE & TRANSACTIONS (BulkSMS BD Integration)
// =====================================================================

model SmsBalance {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  doctorId     Int?     @unique
  smsEnabled   Boolean  @default(false)
  totalCredits Int      @default(0)
  usedCredits  Int      @default(0)
  lowBalanceAlert Int   @default(10)
  lastTopupAt  DateTime?
  autoDisableAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions SmsTransaction[]

  @@index([userId])
  @@index([doctorId])
}

model SmsTransaction {
  id              Int      @id @default(autoincrement())
  userId          Int
  balanceId       Int
  type            SmsTransactionType
  amount          Int      // positive for top-up, negative for usage
  credits         Int      // SMS credits
  costBdt         Float    // amount in BDT
  bkashTrxId      String?
  bkashPaymentId  String?
  status          SmsTransactionStatus @default(PENDING)
  description     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance SmsBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([balanceId])
  @@index([status])
  @@index([bkashPaymentId])
}

model PendingBkashPayment {
  id              Int      @id @default(autoincrement())
  paymentId       String   @unique // bKash payment ID
  userId          Int
  credits         Int
  costBdt         Float
  invoiceNumber   String
  status          PendingPaymentStatus @default(PENDING)
  trxId           String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([userId])
  @@index([status])
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  COMPLETED
  NO_SHOW
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  PHONE
  WALK_IN
  RECEPTIONIST
  ADMIN
}

enum SmsTransactionType {
  TOPUP
  USAGE
  REFUND
  ADJUSTMENT
}

enum SmsTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PendingPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}
